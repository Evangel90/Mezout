// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Mezout settings for each shop. The API key and webhook signing secret are secrets: keep this database private.
model MezoutShop {
  shop              String   @id
  apiKey            String   @default("")
  gatewayName       String   @default("")
  linkLifetimeHours Int      @default(24)
  webhookEndpointId String?
  webhookUrl        String?
  webhookSecret     String?
  webhookKeyHash    String?
  appUrlPublished   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// One Mezout invoice per Shopify order paid with the Mezout manual payment method.
model MezoutOrder {
  id          Int      @id @default(autoincrement())
  shop        String
  orderId     String
  orderGid    String
  orderName   String
  invoiceId   String
  checkoutUrl String
  amount      String
  expiresAt   DateTime
  status      String   @default("pending")
  txHash      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shop, orderId])
  @@unique([shop, invoiceId])
}

// Mezout event ids already handled, so a redelivered webhook is ignored.
model MezoutEvent {
  shop       String
  eventId    String
  receivedAt DateTime @default(now())

  @@id([shop, eventId])
}
