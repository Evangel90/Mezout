# Optional. The Mezout API the app talks to. Defaults to production Mezout (testnet): https://usemezout.vercel.app
# Set it in the shell that runs `pnpm dev`, e.g. `MEZOUT_API_BASE=https://usemezout.vercel.app pnpm dev`.
MEZOUT_API_BASE=

# Set by `shopify app dev` automatically; needed only when running the built app yourself (`pnpm start`).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_orders,write_orders
