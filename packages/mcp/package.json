{
  "name": "@mezout/mcp",
  "version": "0.1.0",
  "description": "MCP server for Mezout: let AI agents create, check, refund and pay Mezout invoices in MUSD, and pay HTTP 402 Mezout paywalls, on Mezo testnet.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mezout",
    "mezo",
    "musd",
    "x402",
    "ai-agents",
    "payments"
  ],
  "license": "MIT",
  "homepage": "https://usemezout.vercel.app/docs#ai-agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Evangel90/Mezout.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/Evangel90/Mezout/issues"
  },
  "type": "module",
  "bin": {
    "mezout-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "viem": "^2.22.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@mezout/paywall": "workspace:^",
    "@mezout/sdk": "workspace:^",
    "@types/node": "^20",
    "tsup": "8.5.0",
    "typescript": "^5",
    "vitest": "^3"
  }
}
