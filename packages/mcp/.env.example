# Mezout MCP server settings. Put real values in your MCP client's config or a local .env.local, never in git.
MEZOUT_API_URL=https://usemezout.vercel.app
# Merchant tools (create_invoice, get_invoice, list_invoices, refund, verify_payment)
MEZOUT_API_KEY=
# Payer tools (pay_invoice, fetch_paid_resource, get_budget): a Mezo testnet key holding test MUSD
MEZOUT_PAYER_PRIVATE_KEY=
MEZOUT_MAX_PAYMENT_MUSD=1
MEZOUT_MAX_SESSION_MUSD=10
MEZO_RPC_URL=https://rpc.test.mezo.org
