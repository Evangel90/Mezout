# Copy to .env.local (never commit it). Names only, never values.
MEZO_RPC_URL=https://rpc.test.mezo.org
RELAYER_PRIVATE_KEY=
RELAYER_ADDRESS=
INVOICE_SIGNER_PRIVATE_KEY=
INVOICE_SIGNER_ADDRESS=
FEE_RECIPIENT_ADDRESS=
# Merchant-paid testnet settlement fee in basis points. 100 = 1%; 0 pauses fees for newly created invoices.
MERCHANT_FEE_BPS=100
NEXT_PUBLIC_ROUTER_ADDRESS=
DATABASE_URL=
# Neon direct (unpooled) URL; used only by `pnpm db:migrate:prod` to migrate production.
DATABASE_URL_UNPOOLED=
# Derives each webhook endpoint's signing secret. Changing it changes every endpoint's secret.
WEBHOOK_SIGNING_SECRET=
# Bearer token for /api/cron (the indexer); the same value is the CRON_SECRET GitHub Actions secret.
CRON_SECRET=
